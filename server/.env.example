# 复制为 .env 使用；真实密钥只进 .env，禁止提交仓库
DATABASE_URL=sqlite:///./data/app.db

# python -c "import secrets;print(secrets.token_hex(32))" 各生成一个，生产部署时重新生成
JWT_SECRET_STUDENT=change-me-student-secret
JWT_SECRET_STAFF=change-me-staff-secret
JWT_EXPIRE_DAYS=14

# console | mailpit | smtp（切换只改这一行，不改业务代码）
EMAIL_BACKEND=console
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SSL=false
MAIL_FROM_NAME=NiceOffer 班主任

# 邮件内链接前缀；本地开发为学员端 dev server 地址
APP_BASE_URL=http://localhost:5173

ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=ChangeMe123!

TZ=Asia/Shanghai
TESTING=false
